<?xml version="1.0" encoding="utf-8"?>
<!-- Compact, ephemeral Express offer overlay. Tapping opens the existing
     authenticated offer popup. Dismiss does not accept/reject server offers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offer_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="8dp"
    android:paddingEnd="11dp"
    android:paddingBottom="7dp"
    android:background="#FF162B43"
    android:elevation="12dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="Ver nueva oferta Express. Desliza arriba, izquierda o derecha para descartar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/offer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="EXPRESS · NUEVO VIAJE"
            android:textColor="#FF53CEFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offer_remaining"
            android:layout_width="49dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="30s"
            android:textColor="#FFACF9C9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="Segundos restantes de la barra" />

        <TextView
            android:id="@+id/offer_close"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginStart="7dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFF3FAFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Descartar aviso flotante" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/offer_service_icon"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:background="#243C57"
            android:src="@drawable/ic_express_notification_large"
            android:contentDescription="Express" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitud disponible"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/offer_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#FFB2C5D9"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/offer_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLP $2.226"
                android:textColor="#FF51C9FF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ver oferta ›"
                android:textColor="#FFBFD2E8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/offer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="9dp"
        android:max="1000"
        android:progress="1000"
        android:progressTint="#FF40BFFF"
        android:progressBackgroundTint="#FF2B4057" />
</LinearLayout>
